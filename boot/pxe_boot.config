# ==============================================================================
# StripperOS Master PXE Network-Boot Deployment Configuration
# License: MIT
# ==============================================================================

default stripperos-rt

label stripperos-rt
    menu label ^StripperOS (High-Throughput Real-Time Kernel Minimal)
    kernel vmlinuz-stripper-rt
    append initrd=initrd.img-stripper-rt os_mode=immutable quiet splash processor.max_cstate=1 intel_idle.max_cstate=0 amd_iommu=on vga=normal

label stripperos-recovery
    menu label ^StripperOS Core Recovery Diagnostic Mode
    kernel vmlinuz-stripper-rt
    append initrd=initrd.img-stripper-rt os_mode=maintenance single

timeout 30
prompt 1

